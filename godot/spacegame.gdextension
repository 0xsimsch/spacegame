[configuration]
entry_symbol = "gdext_rust_init"
compatibility_minimum = 4.5
reloadable = true

[libraries]
linux.debug.x86_64 = "res://../target/debug/libclient.so"
linux.release.x86_64 = "res://../target/release/libclient.so"
windows.debug.x86_64 = "res://../target/debug/client.dll"
windows.release.x86_64 = "res://../target/release/client.dll"
macos.debug = "res://../target/debug/libclient.dylib"
macos.release = "res://../target/release/libclient.dylib"
