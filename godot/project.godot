; Engine configuration file.
config_version=5

[application]

config/name="Spacegame Prototype"
config/description="Godot + Rust prototype: solar system, grid building, programmable blocks, multiplayer."
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[display]

